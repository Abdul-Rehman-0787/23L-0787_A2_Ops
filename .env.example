# VisionGuard: variables for the HOSTED deployment (Render service "visionguard-platform").
#
# This file is a checklist with fake values. It is safe to commit.
# Real values go in Render -> your service -> Environment (never in Git).
# Variables marked [render.yaml] are already set there with fixed values;
# variables marked [PASTE] are the ones you must paste in the Render dashboard.

# ---------------------------------------------------------------- hosted behaviour
COOKIE_SECURE=1                 # [render.yaml] cookies only over HTTPS
DEV_LOG_CODES=0                 # [render.yaml] never print login codes in logs
CELERY_EAGER=1                  # [render.yaml] no free worker: run tasks inside the web app
MAX_UPLOAD_MB=5                 # [render.yaml]
JWT_SECRET=                     # [render.yaml] generated by Render (>= 32 random characters)
OTP_SECRET=                     # [render.yaml] generated by Render (>= 32 random characters)

# ---------------------------------------------------------------- model API (the existing service)
INFERENCE_MODE=remote           # [render.yaml] the hosted web app never loads a model itself
API_URL=https://visionguard-vkzn.onrender.com       # [PASTE] base address of the model API
API_KEY=change-me               # [PASTE] same value as API_KEY on the model API service
API_TIMEOUT=90                  # [render.yaml] covers the model API's cold start
MODEL_LABEL=Model v2 (recommended)          # [render.yaml] name shown in the model drop-down
# Optional second model API. Leave MODEL2_API_URL empty to offer only one model.
MODEL2_API_URL=https://visionguard-model-v1.onrender.com   # [PASTE]
MODEL2_API_KEY=change-me        # [PASTE] API_KEY of the second model service
MODEL2_LABEL=Model v1 (baseline)            # [render.yaml]
MODEL_NAME=visionguard          # [render.yaml]
MODEL_VERSION=2                 # [render.yaml]
THRESHOLD=0.48                  # [render.yaml]

# ---------------------------------------------------------------- Postgres (Neon or Supabase, free)
# Must start with postgresql+psycopg2:// and end with ?sslmode=require
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST/DBNAME?sslmode=require     # [PASTE]

# ---------------------------------------------------------------- Redis (Upstash, free)
# Login codes, sessions and rate limits. Note the double "s": rediss://
REDIS_URL=rediss://default:PASSWORD@HOST.upstash.io:6379     # [PASTE]

# ---------------------------------------------------------------- Neo4j (Aura Free)
NEO4J_URI=neo4j+s://XXXXXXXX.databases.neo4j.io     # [PASTE] note: neo4j+s, not bolt
NEO4J_USER=neo4j                # [render.yaml]
NEO4J_PASSWORD=                 # [PASTE] shown only once when the Aura instance is created

# ---------------------------------------------------------------- Artist (Groq)
LLM_PROVIDER=groq               # [render.yaml]
GROQ_API_KEY=gsk_xxxxxxxx       # [PASTE]
GROQ_MODEL=llama-3.1-8b-instant # [render.yaml] check the current name in the Groq console
LLM_TIMEOUT=60                  # [render.yaml]
LLM_MAX_TOKENS=300              # [render.yaml]
RAG_MIN_SIMILARITY=0.55         # [render.yaml]

# ---------------------------------------------------------------- email (Brevo HTTPS API)
# Render's free tier blocks SMTP ports, so the hosted app uses Brevo's API instead.
MAIL_PROVIDER=brevo             # [render.yaml]
BREVO_API_KEY=xkeysib-xxxxxxxx  # [PASTE]
MAIL_FROM=VisionGuard <you@example.com>     # [PASTE] must be a sender verified in Brevo

# ---------------------------------------------------------------- GitHub (not Render)
# Repository secret   RENDER_DEPLOY_HOOK_WEB    the service's Deploy Hook URL
# Repository variable APP_URL                   https://<your-service>.onrender.com
# Repository variable DEPLOY_ENABLED            true   (turns the deploy job on)
